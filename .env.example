# Copy to .env. Never commit real credentials.
SOURCE_MODE=replay
MODEL_MODE=offline
SERVICE_TOKEN=local-development-only
AGENT_URL=http://127.0.0.1:8001
SPLUNK_URL=https://your-splunk-host:8089
SPLUNK_TOKEN=
SPLUNK_VERIFY_TLS=true
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen3.8-flash
# Alternatives: deepseek-v4-flash-0731, kimi-k3
LLM_CONTEXT_TOKENS=32000
# Includes reasoning tokens for models that count them toward completion limits.
LLM_MAX_OUTPUT_TOKENS=8192
MAX_INPUT_TOKENS=16000
MAX_MODEL_CALLS=8
MAX_FOLLOWUPS=3
TASK_TIMEOUT_SECONDS=180

# Local PostgreSQL. Create a dedicated database/user; replace the password.
DATABASE_URL=postgresql://tracelens:replace-me@127.0.0.1:5432/tracelens
# Docker Desktop reaches the same host PostgreSQL via this hostname.
DOCKER_DATABASE_URL=postgresql://tracelens:replace-me@host.docker.internal:5432/tracelens

# INFO: key lifecycle events. DEBUG: additionally record completed graph nodes.
LOG_LEVEL=INFO
