# 复制为 .env，并只在公司内网填写真实值。不要提交 .env。

# API Service 与 Agent Service 之间的内部认证令牌，至少 16 位。
SERVICE_TOKEN=replace-with-a-long-random-token

# PostgreSQL 连接串。Docker 部署时主机名必须能从容器内访问。
DATABASE_URL=postgresql://user:password@postgres-host:5432/issue_troubleshooting

# Splunk Management API。
SPLUNK_URL=https://splunk.company.internal:8089
SPLUNK_TOKEN=replace-with-splunk-token
SPLUNK_VERIFY_TLS=true

# 公司内部 OpenAI 兼容模型网关。
LLM_BASE_URL=https://llm.company.internal/v1
LLM_API_KEY=replace-with-model-key
LLM_MODEL=replace-with-model-name
