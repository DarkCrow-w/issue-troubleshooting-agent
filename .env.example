# 复制为 .env，并只在公司内网填写真实值。不要提交 .env。

# API Service 与 Agent Service 之间的内部认证令牌，至少 16 位。
SERVICE_TOKEN=replace-with-a-long-random-token

# PostgreSQL 连接串。数据库本身需由管理员提前创建；db:init 负责创建表和索引。
# Docker 部署时主机名必须能从容器内访问。
DATABASE_URL=postgresql://user:password@postgres-host:5432/issue_troubleshooting

# 每个环境使用独立的 Splunk Management API。环境名必须与 settings.yaml 一致。
# 整行是 JSON；外层单引号仅用于保护 JSON 中的双引号。
SPLUNK_CONNECTIONS='{"sit":{"url":"https://splunk-sit.company.internal:8089","token":"replace-with-sit-token","verify_tls":true},"uat":{"url":"https://splunk-uat.company.internal:8089","token":"replace-with-uat-token","verify_tls":true},"production":{"url":"https://splunk.company.internal:8089","token":"replace-with-production-token","verify_tls":true}}'

# 公司内部 OpenAI 兼容模型网关。
LLM_BASE_URL=https://llm.company.internal/v1
LLM_API_KEY=replace-with-model-key
LLM_MODEL=replace-with-model-name

# 大日志的结构化诊断可能超过一分钟，可按内部网关性能调整。
LLM_TIMEOUT_SECONDS=180

# 结构化 JSON 诊断默认关闭思考，避免思考过程占满输出预算。
LLM_ENABLE_THINKING=false
