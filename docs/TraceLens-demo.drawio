  <diagram id="skills" name="03-Skill与安全设计">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="950" math="0" shadow="0">
      <root>
        <mxCell id="s0"/>
        <mxCell id="s1" parent="s0"/>
        <mxCell id="sTitle" value="可插拔 Skill、两种排查流程与安全边界" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#173B36;" vertex="1" parent="s1"><mxGeometry x="55" y="25" width="760" height="42" as="geometry"/></mxCell>
        <mxCell id="sSub" value="团队可以通过 manifest + prompt 组合业务能力；模型能力被限定在受控接口之后" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#60746F;" vertex="1" parent="s1"><mxGeometry x="55" y="67" width="900" height="25" as="geometry"/></mxCell>

        <mxCell id="registry" value="&lt;b&gt;SkillRegistry&lt;/b&gt;&lt;br&gt;&lt;font color='#55716A'&gt;加载 skill.yaml + prompt.md&lt;br&gt;校验依赖、循环、重复、工具白名单、输出契约&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B36;strokeColor=#173B36;fontColor=#FFFFFF;fontSize=13;arcSize=14;spacing=10;" vertex="1" parent="s1"><mxGeometry x="560" y="120" width="480" height="82" as="geometry"/></mxCell>
        <mxCell id="manifest" value="&lt;b&gt;Manifest&lt;/b&gt;&lt;br&gt;id · version · kind · depends_on · tools · output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FAF8;strokeColor=#7BA99D;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="200" y="125" width="280" height="72" as="geometry"/></mxCell>
        <mxCell id="prompt" value="&lt;b&gt;Prompt / 团队知识&lt;/b&gt;&lt;br&gt;错误码含义 · 判断边界 · 验证建议" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FAF8;strokeColor=#7BA99D;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="1120" y="125" width="280" height="72" as="geometry"/></mxCell>

        <mxCell id="codeGroup" value="Code Skills｜确定性事实" style="swimlane;html=1;rounded=1;startSize=35;horizontal=1;fillColor=#EAF5F1;swimlaneFillColor=#FFFFFF;strokeColor=#7BA99D;fontColor=#173B36;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="70" y="260" width="930" height="240" as="geometry"/></mxCell>
        <mxCell id="requestSkill" value="&lt;b&gt;request-response&lt;/b&gt;&lt;br&gt;&lt;font color='#64736F'&gt;识别请求/响应&lt;br&gt;按 callId 配对&lt;br&gt;标记缺失或歧义&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8BAAA2;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="105" y="330" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="exceptionSkill" value="&lt;b&gt;exception-analysis&lt;/b&gt;&lt;br&gt;&lt;font color='#64736F'&gt;Java Exception/Error&lt;br&gt;Caused by 异常链&lt;br&gt;保留栈证据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8BAAA2;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="325" y="330" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="traceSkill" value="&lt;b&gt;trace-reconstruction&lt;/b&gt;&lt;br&gt;&lt;font color='#64736F'&gt;服务 / API / 时间线&lt;br&gt;显式父子边&lt;br&gt;唯一候选推测边&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8BAAA2;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="545" y="330" width="190" height="105" as="geometry"/></mxCell>
        <mxCell id="failureSkill" value="&lt;b&gt;failure-localization&lt;/b&gt;&lt;br&gt;&lt;font color='#64736F'&gt;HTTP 状态&lt;br&gt;业务码&lt;br&gt;异常失败信号&lt;br&gt;最早观测失败&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8BAAA2;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="765" y="330" width="190" height="105" as="geometry"/></mxCell>

        <mxCell id="agentGroup" value="Agent Skills｜受控补查与解释" style="swimlane;html=1;rounded=1;startSize=35;horizontal=1;fillColor=#EEF0F8;swimlaneFillColor=#FFFFFF;strokeColor=#7E88A6;fontColor=#303A59;fontStyle=1;" vertex="1" parent="s1"><mxGeometry x="1040" y="260" width="490" height="240" as="geometry"/></mxCell>
        <mxCell id="followSkill" value="&lt;b&gt;evidence-followup&lt;/b&gt;&lt;br&gt;&lt;font color='#59627A'&gt;模型/规则提出补查建议&lt;br&gt;工具：propose_followup&lt;br&gt;代码决定是否执行&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E88A6;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="1075" y="330" width="195" height="105" as="geometry"/></mxCell>
        <mxCell id="reportSkill" value="&lt;b&gt;diagnosis-report&lt;/b&gt;&lt;br&gt;&lt;font color='#59627A'&gt;综合事实与假设&lt;br&gt;工具：read_evidence&lt;br&gt;结构化证据报告&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7E88A6;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="1300" y="330" width="195" height="105" as="geometry"/></mxCell>

        <mxCell id="flowStandard" value="&lt;b&gt;流程 A｜完整交易链路与故障排查&lt;/b&gt;&lt;br&gt;&lt;font color='#4F6C65'&gt;4 个 Code Skills → 自动补查（最多 3 次）→ 诊断报告&lt;br&gt;适合：日志分散、关联字段可能变化、需要尽量补齐证据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5F1;strokeColor=#5E9285;fontSize=13;arcSize=14;spacing=12;" vertex="1" parent="s1"><mxGeometry x="70" y="555" width="700" height="95" as="geometry"/></mxCell>
        <mxCell id="flowFast" value="&lt;b&gt;流程 B｜聚焦异常与失败原因&lt;/b&gt;&lt;br&gt;&lt;font color='#6F624E'&gt;4 个 Code Skills → 不自动补查 → 诊断报告&lt;br&gt;适合：首次查询日志已完整、希望更快完成、严格控制查询次数&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EB;strokeColor=#C49757;fontSize=13;arcSize=14;spacing=12;" vertex="1" parent="s1"><mxGeometry x="830" y="555" width="700" height="95" as="geometry"/></mxCell>

        <mxCell id="security1" value="&lt;b&gt;数据策略&lt;/b&gt;&lt;br&gt;原始字段和值不替换&lt;br&gt;清洗只控制模型材料大小" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2EE;strokeColor=#C77B66;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="70" y="720" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="security2" value="&lt;b&gt;模型安全&lt;/b&gt;&lt;br&gt;日志视为不可信数据&lt;br&gt;JSON Schema + 证据 ID 双重校验&lt;br&gt;最多一次格式修复" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2EE;strokeColor=#C77B66;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="370" y="720" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="security3" value="&lt;b&gt;工具安全&lt;/b&gt;&lt;br&gt;模型不能执行任意 SPL / Shell&lt;br&gt;补查只接受已观测 ID&lt;br&gt;不越过环境与时间范围" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2EE;strokeColor=#C77B66;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="670" y="720" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="security4" value="&lt;b&gt;运行安全&lt;/b&gt;&lt;br&gt;查询、事件、字节、模型、时间预算&lt;br&gt;SDK 自动重试关闭&lt;br&gt;取消/超时保留部分事实" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2EE;strokeColor=#C77B66;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="970" y="720" width="275" height="100" as="geometry"/></mxCell>
        <mxCell id="security5" value="&lt;b&gt;审计与存储&lt;/b&gt;&lt;br&gt;PostgreSQL JSONB&lt;br&gt;配置与 Skill digest 快照&lt;br&gt;默认 24 小时清理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2EE;strokeColor=#C77B66;fontSize=12;arcSize=12;" vertex="1" parent="s1"><mxGeometry x="1270" y="720" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="extension" value="新增业务能力：创建 skills/&lt;name&gt;/skill.yaml + prompt.md → 声明 depends_on / tools / output → 加入 workflow → 启动时统一校验；可信代码规则需显式注册，不执行动态上传代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B36;strokeColor=#173B36;fontColor=#FFFFFF;fontSize=12;fontStyle=1;arcSize=12;spacing=10;" vertex="1" parent="s1"><mxGeometry x="70" y="865" width="1460" height="55" as="geometry"/></mxCell>

        <mxCell id="se1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5E9285;" edge="1" parent="s1" source="manifest" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5E9285;" edge="1" parent="s1" source="prompt" target="registry"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se3" value="构建 workflow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5E9285;fontSize=10;fontColor=#547970;" edge="1" parent="s1" source="registry" target="codeGroup"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="se4" value="构建 workflow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7E88A6;fontSize=10;fontColor=#59627A;" edge="1" parent="s1" source="registry" target="agentGroup"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
