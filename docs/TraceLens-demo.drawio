  <diagram id="overview" name="01-产品全景">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="TraceLens｜交易问题排查 Agent" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#173B36;" vertex="1" parent="1"><mxGeometry x="60" y="30" width="620" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="输入一个关联 ID，自动还原调用链、定位最早失败、解释原因，并让每条结论都能回查证据" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#60746F;" vertex="1" parent="1"><mxGeometry x="60" y="75" width="960" height="28" as="geometry"/></mxCell>
        <mxCell id="userLane" value="使用者" style="swimlane;html=1;rounded=1;startSize=34;horizontal=0;fillColor=#F7F8F7;swimlaneFillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#60746F;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="180" height="570" as="geometry"/></mxCell>
        <mxCell id="platformLane" value="TraceLens 平台" style="swimlane;html=1;rounded=1;startSize=34;horizontal=0;fillColor=#EAF5F1;swimlaneFillColor=#FFFFFF;strokeColor=#7BA99D;fontColor=#173B36;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="130" width="900" height="570" as="geometry"/></mxCell>
        <mxCell id="externalLane" value="企业能力" style="swimlane;html=1;rounded=1;startSize=34;horizontal=0;fillColor=#F8F1E8;swimlaneFillColor=#FFFFFF;strokeColor=#C8A97E;fontColor=#755A36;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="130" width="320" height="570" as="geometry"/></mxCell>

        <mxCell id="operator" value="&lt;b&gt;运维 / 开发 / 业务支持&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7774'&gt;提供 seqNo 或 correlationId&lt;br&gt;可补充重点排查问题&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;fontSize=13;arcSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="230" width="140" height="100" as="geometry"/></mxCell>
        <mxCell id="resultUser" value="&lt;b&gt;获得可行动的答案&lt;/b&gt;&lt;br&gt;&lt;font color='#6B7774'&gt;• 经过哪些服务/API&lt;br&gt;• 哪里最先失败&lt;br&gt;• 原因、假设与下一步&lt;br&gt;• 点击查看原始证据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#AAB8B4;fontSize=12;arcSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="80" y="470" width="140" height="145" as="geometry"/></mxCell>

        <mxCell id="web" value="&lt;b&gt;极简对话式工作台&lt;/b&gt;&lt;br&gt;&lt;font color='#58716B'&gt;交易 ID · 时间范围 · 环境 · 流程&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4FAF8;strokeColor=#7BA99D;fontSize=14;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="320" y="185" width="240" height="75" as="geometry"/></mxCell>
        <mxCell id="publicApi" value="&lt;b&gt;API Service&lt;/b&gt;&lt;br&gt;&lt;font color='#58716B'&gt;浏览器接口 · 转发 · 隔离内部令牌&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7BA99D;fontSize=13;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="185" width="220" height="75" as="geometry"/></mxCell>
        <mxCell id="agentApi" value="&lt;b&gt;Agent Service&lt;/b&gt;&lt;br&gt;&lt;font color='#58716B'&gt;任务队列 · 取消 · 超时 · 生命周期&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7BA99D;fontSize=13;arcSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="890" y="185" width="240" height="75" as="geometry"/></mxCell>

        <mxCell id="graphBox" value="&lt;b&gt;LangGraph 排查引擎&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B36;strokeColor=#173B36;fontColor=#FFFFFF;fontSize=15;fontStyle=1;arcSize=14;" vertex="1" parent="1"><mxGeometry x="390" y="320" width="650" height="50" as="geometry"/></mxCell>
        <mxCell id="retrieve" value="1  查询并采集&lt;br&gt;&lt;font color='#6B7774'&gt;按关联 ID / 上下文补查&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9EB9B1;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="405" width="175" height="70" as="geometry"/></mxCell>
        <mxCell id="protect" value="2  日志标准化&lt;br&gt;&lt;font color='#6B7774'&gt;Java 日志 / 嵌套 JSON / 字段统一&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9EB9B1;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="405" width="190" height="70" as="geometry"/></mxCell>
        <mxCell id="rules" value="3  确定性事实提取&lt;br&gt;&lt;font color='#6B7774'&gt;请求响应 · 异常链 · 调用图 · 失败信号&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9EB9B1;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="735" y="405" width="195" height="70" as="geometry"/></mxCell>
        <mxCell id="reason" value="4  证据化推理&lt;br&gt;&lt;font color='#6B7774'&gt;LangChain · 结构校验 · 引用校验&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9EB9B1;fontSize=12;arcSize=12;" vertex="1" parent="1"><mxGeometry x="955" y="405" width="175" height="70" as="geometry"/></mxCell>
        <mxCell id="report" value="5  生成排查报告&lt;br&gt;&lt;font color='#6B7774'&gt;事实 / 假设 / 未知 / 下一步 / 证据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4E3;strokeColor=#7EA36B;fontSize=13;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="615" y="530" width="250" height="75" as="geometry"/></mxCell>

        <mxCell id="splunk" value="&lt;b&gt;Splunk&lt;/b&gt;&lt;br&gt;&lt;font color='#755A36'&gt;原始 Java 日志&lt;br&gt;关联字段检索&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF8EF;strokeColor=#C8A97E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1260" y="205" width="125" height="90" as="geometry"/></mxCell>
        <mxCell id="qwen" value="&lt;b&gt;千问兼容模型&lt;/b&gt;&lt;br&gt;&lt;font color='#755A36'&gt;根因解释与综合&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8EF;strokeColor=#C8A97E;fontSize=13;arcSize=14;" vertex="1" parent="1"><mxGeometry x="1410" y="205" width="105" height="90" as="geometry"/></mxCell>
        <mxCell id="postgres" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font color='#755A36'&gt;任务 · 报告&lt;br&gt;JSONB 原始证据&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FFF8EF;strokeColor=#C8A97E;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1325" y="485" width="130" height="100" as="geometry"/></mxCell>

        <mxCell id="safety" value="&lt;b&gt;质量护栏&lt;/b&gt;　证据 ID 校验　｜　查询/字节/token/时间预算　｜　部分失败保留已完成事实　｜　原始证据可回查" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF6E8;strokeColor=#D6AA65;fontColor=#6E522A;fontSize=12;arcSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="280" y="740" width="1260" height="60" as="geometry"/></mxCell>
        <mxCell id="demoTip" value="Demo 讲法：输入交易 ID → 看调用链 → 定位 cm-acct-scene 的 SQL 超时 → 看失败如何传播为网关 502 → 点击证据验证结论" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B36;strokeColor=#173B36;fontColor=#FFFFFF;fontSize=13;fontStyle=1;arcSize=12;spacing=10;" vertex="1" parent="1"><mxGeometry x="280" y="825" width="1260" height="45" as="geometry"/></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#547970;strokeWidth=2;" edge="1" parent="1" source="operator" target="web"><mxGeometry relative="1" as="geometry"/></mxCell>
