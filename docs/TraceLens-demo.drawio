  <diagram id="runtime" name="02-排查执行流程">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="r0"/>
        <mxCell id="r1" parent="r0"/>
        <mxCell id="rTitle" value="一次交易排查如何执行｜LangGraph 状态图" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;fontColor=#173B36;" vertex="1" parent="r1"><mxGeometry x="55" y="25" width="750" height="42" as="geometry"/></mxCell>
        <mxCell id="rSub" value="所有循环都有硬预算；模型只能提出建议，查询范围与证据引用始终由代码校验" style="text;html=1;strokeColor=none;fillColor=none;fontSize=13;fontColor=#60746F;" vertex="1" parent="r1"><mxGeometry x="55" y="67" width="900" height="25" as="geometry"/></mxCell>

        <mxCell id="submit" value="提交排查请求&lt;br&gt;&lt;font color='#667874'&gt;关联 ID · 环境 · 时间范围 · workflow · 问题&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#173B36;strokeColor=#173B36;fontColor=#FFFFFF;fontSize=14;fontStyle=1;arcSize=16;" vertex="1" parent="r1"><mxGeometry x="610" y="110" width="380" height="62" as="geometry"/></mxCell>
        <mxCell id="validate" value="接口校验&lt;br&gt;&lt;font color='#64736F'&gt;环境白名单 · workflow · 时间范围 · ID 安全转义&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8BAAA2;fontSize=12;arcSize=12;" vertex="1" parent="r1"><mxGeometry x="620" y="200" width="360" height="62" as="geometry"/></mxCell>
        <mxCell id="queue" value="任务入队（单 worker）&lt;br&gt;&lt;font color='#64736F'&gt;写 PostgreSQL · 返回 task_id · 支持取消&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8BAAA2;fontSize=12;arcSize=12;" vertex="1" parent="r1"><mxGeometry x="620" y="290" width="360" height="62" as="geometry"/></mxCell>
        <mxCell id="init" value="初始化本次运行&lt;br&gt;&lt;font color='#64736F'&gt;独立 State · Budget · ModelClient · 配置/Skill 快照&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#8BAAA2;fontSize=12;arcSize=12;" vertex="1" parent="r1"><mxGeometry x="620" y="380" width="360" height="62" as="geometry"/></mxCell>
        <mxCell id="query" value="查询日志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5F1;strokeColor=#5E9285;fontSize=14;fontStyle=1;arcSize=14;" vertex="1" parent="r1"><mxGeometry x="160" y="510" width="190" height="55" as="geometry"/></mxCell>
        <mxCell id="normalize" value="标准化 → 交易归属判断 → 去重 → 原始证据立即落库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5F1;strokeColor=#5E9285;fontSize=12;arcSize=14;" vertex="1" parent="r1"><mxGeometry x="405" y="505" width="345" height="65" as="geometry"/></mxCell>
        <mxCell id="skills" value="依赖顺序执行 Code Skills&lt;br&gt;&lt;font color='#4F6C65'&gt;请求响应配对 → Java 异常链 → 调用图 → 失败定位&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF5F1;strokeColor=#5E9285;fontSize=12;arcSize=14;" vertex="1" parent="r1"><mxGeometry x="805" y="500" width="340" height="75" as="geometry"/></mxCell>
        <mxCell id="follow" value="当前流程启用自动补查？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#C49757;fontSize=12;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="1225" y="480" width="210" height="115" as="geometry"/></mxCell>
        <mxCell id="proposal" value="生成候选&lt;br&gt;&lt;font color='#6F624E'&gt;新关联 ID / 异常实例前后 2 秒&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9EF;strokeColor=#C49757;fontSize=12;arcSize=12;" vertex="1" parent="r1"><mxGeometry x="1215" y="640" width="230" height="65" as="geometry"/></mxCell>
        <mxCell id="validateProposal" value="代码校验通过且预算充足？&lt;br&gt;&lt;font color='#6F624E'&gt;证据归属 · ID 来源 · 环境 · 时间窗 · 去重&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF5E6;strokeColor=#C49757;fontSize=11;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="1190" y="750" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="prepare" value="准备模型材料&lt;br&gt;&lt;font color='#566B66'&gt;按输入预算分块 · 失败证据优先 · 超长日志完整分片&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F2F8;strokeColor=#7E88A6;fontSize=12;arcSize=12;" vertex="1" parent="r1"><mxGeometry x="720" y="650" width="340" height="70" as="geometry"/></mxCell>
        <mxCell id="online" value="在线模型且有证据？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#7E88A6;fontSize=12;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="760" y="760" width="250" height="110" as="geometry"/></mxCell>
        <mxCell id="analyse" value="LangChain 分块分析&lt;br&gt;&lt;font color='#59627A'&gt;提示词隔离 · Pydantic 解析 · 证据 ID 校验&lt;br&gt;可请求一次完整原始证据&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#7E88A6;fontSize=12;arcSize=12;" vertex="1" parent="r1"><mxGeometry x="385" y="765" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="more" value="还有分块 / 模型 Skill？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#EEF0F8;strokeColor=#7E88A6;fontSize=11;fontStyle=1;" vertex="1" parent="r1"><mxGeometry x="130" y="760" width="205" height="105" as="geometry"/></mxCell>
        <mxCell id="buildReport" value="组装最终报告&lt;br&gt;&lt;font color='#4E6A48'&gt;摘要 · 调用链 · 事实 · 根因假设 · 未知 · 下一步 · 查询记录&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F4E4;strokeColor=#78A168;fontSize=13;fontStyle=1;arcSize=14;" vertex="1" parent="r1"><mxGeometry x="565" y="910" width="470" height="65" as="geometry"/></mxCell>
        <mxCell id="failureNote" value="异常 / 超时 / 取消&lt;br&gt;&lt;font color='#86584C'&gt;停止后续调用，恢复已采集事实和已完成分块，报告标记 partial / failed / cancelled&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0EC;strokeColor=#C77B66;fontSize=11;arcSize=12;dashed=1;" vertex="1" parent="r1"><mxGeometry x="50" y="900" width="430" height="72" as="geometry"/></mxCell>
        <mxCell id="budgetNote" value="运行硬限制&lt;br&gt;&lt;font color='#785F38'&gt;补查 ≤ 3｜事件 ≤ 10,000｜响应 ≤ 50 MB｜模型调用 ≤ 8｜任务 ≤ 180 秒&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8ED;strokeColor=#C9A15F;fontSize=11;arcSize=12;dashed=1;" vertex="1" parent="r1"><mxGeometry x="1080" y="900" width="465" height="72" as="geometry"/></mxCell>

        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547970;strokeWidth=2;" edge="1" parent="r1" source="submit" target="validate"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547970;strokeWidth=2;" edge="1" parent="r1" source="validate" target="queue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547970;strokeWidth=2;" edge="1" parent="r1" source="queue" target="init"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#547970;strokeWidth=2;" edge="1" parent="r1" source="init" target="query"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5E9285;strokeWidth=2;" edge="1" parent="r1" source="query" target="normalize"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5E9285;strokeWidth=2;" edge="1" parent="r1" source="normalize" target="skills"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#5E9285;strokeWidth=2;" edge="1" parent="r1" source="skills" target="follow"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re8" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B1844A;fontColor=#8C693D;fontSize=11;" edge="1" parent="r1" source="follow" target="proposal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#7E88A6;fontColor=#59627A;fontSize=11;" edge="1" parent="r1" source="follow" target="prepare"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B1844A;" edge="1" parent="r1" source="proposal" target="validateProposal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="re11" value="通过：执行补查" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#B1844A;fontColor=#8C693D;fontSize=10;" edge="1" parent="r1" source="validateProposal" target="query"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1510" y="815"/><mxPoint x="1510" y="450"/><mxPoint x="255" y="450"/></Array></mxGeometry></mxCell>
