        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;strokeColor=#547970;strokeWidth=2;" edge="1" parent="1" source="publicApi" target="agentApi"><mxGeometry relative="1" as="geometry"/></mxCell>
